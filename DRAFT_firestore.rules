rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 256
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
        && (data.language == null || (data.language is string && data.language.size() <= 10))
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidUserUpdate(data) {
      return data.uid == existing().uid
        && data.email == existing().email
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
        && (data.language == null || (data.language is string && data.language.size() <= 10))
        && data.createdAt == existing().createdAt
        && data.updatedAt == request.time;
    }

    function isValidHistory(data) {
      return data.userId == request.auth.uid
        && data.toolId is string && data.toolId.size() <= 64
        && data.toolName is string && data.toolName.size() <= 128
        && data.timestamp == request.time;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUserUpdate(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'language', 'updatedAt'])
      );

      match /history/{historyId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(historyId) && isValidHistory(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
